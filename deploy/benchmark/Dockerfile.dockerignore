# Keep the benchmark build context limited to the source required by the four
# binaries in Dockerfile. Local credentials, .env files, results, and state are
# excluded by default instead of relying on an ever-growing denylist.
**

!go.mod
!go.sum

!caddy/
caddy/*
!caddy/agentlog/
!caddy/agentlog/**
!caddy/cachematch/
!caddy/cachematch/**
!caddy/cachepurge/
!caddy/cachepurge/**
!caddy/compression/
!caddy/compression/**
!caddy/govetocache/
!caddy/govetocache/**
!caddy/origingovernance/
!caddy/origingovernance/**
!caddy/simplefs/
!caddy/simplefs/**
!caddy/splitmatch/
!caddy/splitmatch/**
!caddy/waf/
!caddy/waf/**

!cmd/
cmd/*
!cmd/agent-bench/
!cmd/agent-bench/**
!cmd/agent-bench-gateway/
!cmd/agent-bench-gateway/**
!cmd/agent-bench-origin/
!cmd/agent-bench-origin/**
!cmd/edge-agent/
!cmd/edge-agent/**

!internal/
internal/*
!internal/agentbench/
!internal/agentbench/**
!internal/cachecore/
!internal/cachecore/**
!internal/cacherange/
!internal/cacherange/**
!internal/edgeagent/
!internal/edgeagent/**
!internal/edgeprotocol/
!internal/edgeprotocol/**
!internal/geoipdb/
!internal/geoipdb/**
!internal/policy/
!internal/policy/**
!internal/securitystate/
!internal/securitystate/**
