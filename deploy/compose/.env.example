# Copy to .env and adjust before `docker compose up -d`.

# Image tag deployed by deploy/compose/compose.yaml. Prefer a pinned release
# (for example v1.2.3) over latest in production.
GOVETO_IMAGE_TAG=latest

# Host ports published by the control plane. The container always listens
# on 8080/8443 internally; these only change the host side of the mapping.
HTTP_PUBLISH_PORT=8080
HTTP_PUBLISH_HOST=127.0.0.1
AGENT_GATEWAY_PUBLISH_PORT=8443
APP_ENV=development

# Database credentials (compose creates the instance with these).
# REQUIRED: change this placeholder before any production deployment.
POSTGRES_PASSWORD=change-me

# Required for multi-replica deployments; for a single replica the control
# plane generates its credential master key on first startup and stores it in
# the goveto-data volume. Base64-encoded 32-byte value, e.g.
#   openssl rand -base64 32
# NODE_CREDENTIAL_MASTER_KEY=

# Optional: dedicated analytics instance. Defaults to DATABASE_URL inside
# compose (the TimescaleDB service below).
# ANALYTICS_DATABASE_URL=

# Local HTTP evaluation only. Production always forces Secure cookies;
# use compose.https.yaml and APP_ENV=production for remote access.
SESSION_COOKIE_SECURE=false
# CONSOLE_DOMAIN=console.example.com

# Optional shared initialization token for multiple replicas. Generate with
# openssl rand -base64 32, distribute privately, and remove after setup.
# Single replicas generate secrets/initialization.token in goveto-data.
# INIT_TOKEN=

# GeoIP enrichment for analytics; mount the files into the container as shown
# in compose.yaml before enabling.
# GEOIP_DATABASE_PATH=/var/lib/goveto-edge/GeoLite2-City.mmdb
# GEOIP_ASN_DATABASE_PATH=/var/lib/goveto-edge/GeoLite2-ASN.mmdb

# Optional Prometheus scrape endpoint (unauthenticated; restrict at the
# network layer).
# METRICS_ENABLED=true
