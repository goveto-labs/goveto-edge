APP_ENV=development

# API Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# Dedicated TLS 1.3 mTLS management gateway. PUBLIC_ADDRESS must be reachable
# by edge nodes and shared by every control-plane replica.
AGENT_GATEWAY_HOST=0.0.0.0
AGENT_GATEWAY_PORT=8443
AGENT_GATEWAY_PUBLIC_ADDRESS=control.example.com:8443

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goveto?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/goveto
# ANALYTICS_INGEST_CONCURRENCY=4
# ANALYTICS_RAW_RETENTION_DAYS=7
# ANALYTICS_ARCHIVE_DIR=.data/analytics-archive
# ANALYTICS_ARCHIVE_S3_ENDPOINT=https://s3.example.com
# ANALYTICS_ARCHIVE_S3_BUCKET=goveto-logs
# ANALYTICS_ARCHIVE_S3_REGION=us-east-1
# ANALYTICS_ARCHIVE_S3_ACCESS_KEY=
# ANALYTICS_ARCHIVE_S3_SECRET_KEY=
# ANALYTICS_ARCHIVE_S3_SESSION_TOKEN=

# Edge access-log durability and privacy policy.
# EDGE_AGENT_LOG_MAX_BYTES=2147483648
# EDGE_AGENT_LOG_SAMPLE_RATE=1
# EDGE_AGENT_LOG_REDACT_QUERY=true
# EDGE_AGENT_LOG_ANONYMIZE_IP=true
# EDGE_AGENT_LOG_REDACT_HEADERS=authorization,cf-connecting-ip,cookie,forwarded,proxy-authorization,set-cookie,true-client-ip,x-api-key,x-forwarded-for,x-real-ip

# Persistent application data. The node credential key is generated here on first start.
GOVETO_DATA_DIR=.data
# Set the same base64-encoded 32-byte key on every control-plane replica.
# NODE_CREDENTIAL_MASTER_KEY=

# Session
SESSION_COOKIE_NAME=goveto_session
SESSION_TTL=8h
SESSION_COOKIE_SECURE=false
