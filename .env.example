APP_ENV=development

# API Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goveto?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/goveto

# Session
SESSION_COOKIE_NAME=goveto_session
SESSION_TTL=8h
SESSION_COOKIE_SECURE=false
