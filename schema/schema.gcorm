datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "gco-go"
  output   = "./internal/storage/gen"
  package  = "db"
}

enum ConfigStatus {
  DRAFT
  PUBLISHED
  FAILED
  ROLLED_BACK
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NodeStatus {
  PENDING
  INSTALLING
  ONLINE
  OFFLINE
  INSTALL_FAILED
  DISABLED
}

enum OriginProtocol {
  HTTP
  HTTPS
}

enum PurgeType {
  URL
  PREFIX
  TAG
  ALL
}

enum SSHAuthType {
  PASSWORD
  PRIVATE_KEY
}

enum SiteStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      String
  action     String
  resource   String
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Cluster {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  nodes     Node[]
  groups    ClusterGroup[]
  regions   ClusterRegion[]
  dnsLines  DNSLine[]

  @@unique([name])
  @@map("clusters")
}

model ClusterGroup {
  id        String   @id @default(uuid())
  clusterId String   @map("cluster_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cluster   Cluster  @relation(fields: [clusterId], references: [id])
  nodes     Node[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("node_groups")
}

model ClusterRegion {
  id        String   @id @default(uuid())
  clusterId String   @map("cluster_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cluster   Cluster  @relation(fields: [clusterId], references: [id])
  nodes     Node[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("node_regions")
}

model ConfigVersion {
  id         String       @id @default(uuid())
  siteId     String       @map("site_id")
  version    BigInt
  configJson Json         @map("config_json")
  hash       String
  status     ConfigStatus @default(DRAFT)
  createdAt  DateTime     @default(now()) @map("created_at")
  site       Site         @relation(fields: [siteId], references: [id])

  @@unique([siteId, version])
  @@index([siteId, status])
  @@index([createdAt])
  @@map("config_versions")
}

model DNSLine {
  id        String        @id
  clusterId String        @map("cluster_id")
  name      String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  cluster   Cluster       @relation(fields: [clusterId], references: [id])
  nodes     NodeDNSLine[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("dns_lines")
}

model DynamicSetting {
  key         String   @id
  valueJson   Json     @map("value_json")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("dynamic_settings")
}

model Node {
  id          String         @id @default(uuid())
  clusterId   String         @map("cluster_id")
  groupId     String?        @map("group_id")
  regionId    String?        @map("region_id")
  name        String
  version     String?
  heartbeatAt DateTime?      @map("heartbeat_at")
  status      NodeStatus     @default(PENDING)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  cluster     Cluster        @relation(fields: [clusterId], references: [id])
  group       ClusterGroup?  @relation(fields: [groupId], references: [id])
  region      ClusterRegion? @relation(fields: [regionId], references: [id])
  addresses   NodeAddress[]
  dnsLines    NodeDNSLine[]

  @@unique([clusterId, name])
  @@index([clusterId, status])
  @@index([groupId, status])
  @@index([regionId, status])
  @@index([heartbeatAt])
  @@map("nodes")
}

model NodeAddress {
  id        String   @id @default(uuid())
  nodeId    String   @map("node_id")
  address   String   @unique
  primary   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  node      Node     @relation(fields: [nodeId], references: [id])

  @@index([nodeId])
  @@map("node_addresses")
}

model NodeDNSLine {
  nodeId    String  @map("node_id")
  dnsLineId String  @map("dns_line_id")
  node      Node    @relation(fields: [nodeId], references: [id])
  dnsLine   DNSLine @relation(fields: [dnsLineId], references: [id])

  @@id([nodeId, dnsLineId])
  @@index([dnsLineId])
  @@map("node_dns_lines")
}

model OriginPool {
  id        String         @id @default(uuid())
  name      String
  protocol  OriginProtocol @default(HTTPS)
  backends  Json
  healthUri String         @default("/health") @map("health_uri")
  timeout   Int            @default(10000)
  headers   Json
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  sites     Site[]

  @@index([protocol])
  @@map("origin_pools")
}

model Policy {
  id         String   @id @default(uuid())
  name       String
  cacheJson  Json     @map("cache_json")
  wafJson    Json     @map("waf_json")
  ccJson     Json     @map("cc_json")
  accessJson Json     @map("access_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  sites      Site[]

  @@map("policies")
}

model PublishJob {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  version    BigInt
  targets    Json
  status     JobStatus @default(PENDING)
  resultJson Json?     @map("result_json")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  site       Site      @relation(fields: [siteId], references: [id])

  @@index([siteId, version])
  @@index([status, createdAt])
  @@map("publish_jobs")
}

model PurgeJob {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  type       PurgeType
  value      String?
  status     JobStatus @default(PENDING)
  resultJson Json?     @map("result_json")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  site       Site      @relation(fields: [siteId], references: [id])

  @@index([siteId, status])
  @@index([status, createdAt])
  @@map("purge_jobs")
}

model Site {
  id             String          @id @default(uuid())
  hostname       String          @unique
  status         SiteStatus      @default(ACTIVE)
  originPoolId   String          @map("origin_pool_id")
  policyId       String          @map("policy_id")
  version        BigInt          @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  originPool     OriginPool      @relation(fields: [originPoolId], references: [id])
  policy         Policy          @relation(fields: [policyId], references: [id])
  configVersions ConfigVersion[]
  publishJobs    PublishJob[]
  purgeJobs      PurgeJob[]

  @@index([status])
  @@index([originPoolId])
  @@index([policyId])
  @@map("sites")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  name         String
  role         UserRole      @default(VIEWER)
  status       UserStatus    @default(ACTIVE)
  totpSecret   String?       @map("totp_secret")
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     UserSession[]
  auditLogs    AuditLog[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
