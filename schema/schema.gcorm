datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "gco-go"
  output   = "./internal/storage/gen"
  package  = "db"
}

enum ClusterPermission {
  OWNER
  OPERATOR
}

enum ConfigStatus {
  DRAFT
  PUBLISHED
  FAILED
  ROLLED_BACK
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NodeStatus {
  PENDING
  INSTALLING
  ONLINE
  OFFLINE
  INSTALL_FAILED
  DISABLED
}

enum OriginProtocol {
  HTTP
  HTTPS
}

enum PurgeType {
  URL
  PREFIX
  TAG
  ALL
}

enum SSHAuthType {
  PASSWORD
  PRIVATE_KEY
}

enum SiteStatus {
  ACTIVE
  DISABLED
}

enum TLSMinVersion {
  TLS1_2
  TLS1_3
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      String
  action     String
  resource   String
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Certificate {
  id            String            @id @default(uuid())
  clusterId     String            @map("cluster_id")
  name          String
  certPem       String            @db.Text @map("cert_pem")
  privateKeyPem String            @db.Text @map("private_key_pem")
  fingerprint   String
  expiresAt     DateTime          @map("expires_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  cluster       Cluster           @relation(fields: [clusterId], references: [id])
  sites         SiteCertificate[]

  @@unique([clusterId, name])
  @@index([clusterId, expiresAt])
  @@map("certificates")
}

model Cluster {
  id           String          @id @default(uuid())
  creatorId    String          @map("creator_id")
  name         String
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  creator      User            @relation(fields: [creatorId], references: [id])
  members      ClusterMember[]
  nodes        Node[]
  groups       ClusterGroup[]
  regions      ClusterRegion[]
  dnsLines     DNSLine[]
  certificates Certificate[]
  originPools  OriginPool[]
  sites        Site[]

  @@unique([name])
  @@index([creatorId])
  @@map("clusters")
}

model ClusterGroup {
  id        String   @id @default(uuid())
  clusterId String   @map("cluster_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cluster   Cluster  @relation(fields: [clusterId], references: [id])
  nodes     Node[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("node_groups")
}

model ClusterMember {
  clusterId  String            @map("cluster_id")
  userId     String            @map("user_id")
  permission ClusterPermission @default(OPERATOR)
  createdAt  DateTime          @default(now()) @map("created_at")
  cluster    Cluster           @relation(fields: [clusterId], references: [id])
  user       User              @relation(fields: [userId], references: [id])

  @@id([clusterId, userId])
  @@index([userId])
  @@map("cluster_members")
}

model ClusterRegion {
  id        String   @id @default(uuid())
  clusterId String   @map("cluster_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cluster   Cluster  @relation(fields: [clusterId], references: [id])
  nodes     Node[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("node_regions")
}

model ConfigVersion {
  id         String       @id @default(uuid())
  siteId     String       @map("site_id")
  version    BigInt
  configJson Json         @map("config_json")
  hash       String
  status     ConfigStatus @default(DRAFT)
  createdAt  DateTime     @default(now()) @map("created_at")
  site       Site         @relation(fields: [siteId], references: [id])

  @@unique([siteId, version])
  @@index([siteId, status])
  @@index([createdAt])
  @@map("config_versions")
}

model DNSLine {
  id        String        @id
  clusterId String        @map("cluster_id")
  name      String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  cluster   Cluster       @relation(fields: [clusterId], references: [id])
  nodes     NodeDNSLine[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("dns_lines")
}

model DynamicSetting {
  key         String   @id
  valueJson   Json     @map("value_json")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("dynamic_settings")
}

model Node {
  id          String           @id @default(uuid())
  clusterId   String           @map("cluster_id")
  groupId     String?          @map("group_id")
  regionId    String?          @map("region_id")
  name        String
  version     String?
  heartbeatAt DateTime?        @map("heartbeat_at")
  status      NodeStatus       @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  cluster     Cluster          @relation(fields: [clusterId], references: [id])
  group       ClusterGroup?    @relation(fields: [groupId], references: [id])
  region      ClusterRegion?   @relation(fields: [regionId], references: [id])
  addresses   NodeAddress[]
  dnsLines    NodeDNSLine[]
  cacheConfig NodeCacheConfig?

  @@unique([clusterId, name])
  @@index([clusterId, status])
  @@index([groupId, status])
  @@index([regionId, status])
  @@index([heartbeatAt])
  @@map("nodes")
}

model NodeAddress {
  id        String   @id @default(uuid())
  nodeId    String   @map("node_id")
  address   String   @unique
  primary   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  node      Node     @relation(fields: [nodeId], references: [id])

  @@index([nodeId])
  @@map("node_addresses")
}

model NodeCacheConfig {
  id                  String   @id @default(uuid())
  nodeId              String   @unique @map("node_id")
  cacheDir            String   @default("/opt/goveto-edge/cache") @map("cache_dir")
  autoMaxSize         Boolean  @default(true) @map("auto_max_size")
  maxSizeBytes        BigInt?  @map("max_size_bytes")
  maxDiskUsagePercent Int      @default(80) @map("max_disk_usage_percent")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  node                Node     @relation(fields: [nodeId], references: [id])

  @@map("node_cache_configs")
}

model NodeDNSLine {
  nodeId    String  @map("node_id")
  dnsLineId String  @map("dns_line_id")
  node      Node    @relation(fields: [nodeId], references: [id])
  dnsLine   DNSLine @relation(fields: [dnsLineId], references: [id])

  @@id([nodeId, dnsLineId])
  @@index([dnsLineId])
  @@map("node_dns_lines")
}

model OriginBackend {
  id           String         @id @default(uuid())
  originPoolId String         @map("origin_pool_id")
  protocol     OriginProtocol @default(HTTPS)
  address      String
  hostHeader   String?        @map("host_header")
  weight       Int            @default(1)
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  originPool   OriginPool     @relation(fields: [originPoolId], references: [id])

  @@index([originPoolId, enabled])
  @@map("origin_backends")
}

model OriginPool {
  id        String          @id @default(uuid())
  clusterId String          @map("cluster_id")
  name      String
  healthUri String          @default("/health") @map("health_uri")
  timeout   Int             @default(10000)
  headers   Json
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  cluster   Cluster         @relation(fields: [clusterId], references: [id])
  backends  OriginBackend[]
  sites     Site[]

  @@index([clusterId])
  @@map("origin_pools")
}

model Policy {
  id         String   @id @default(uuid())
  name       String
  cacheJson  Json     @map("cache_json")
  wafJson    Json     @map("waf_json")
  ccJson     Json     @map("cc_json")
  accessJson Json     @map("access_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  sites      Site[]

  @@map("policies")
}

model PublishJob {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  version    BigInt
  targets    Json
  status     JobStatus @default(PENDING)
  resultJson Json?     @map("result_json")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  site       Site      @relation(fields: [siteId], references: [id])

  @@index([siteId, version])
  @@index([status, createdAt])
  @@map("publish_jobs")
}

model PurgeJob {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  type       PurgeType
  value      String?
  status     JobStatus @default(PENDING)
  resultJson Json?     @map("result_json")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  site       Site      @relation(fields: [siteId], references: [id])

  @@index([siteId, status])
  @@index([status, createdAt])
  @@map("purge_jobs")
}

model Site {
  id             String              @id @default(uuid())
  clusterId      String              @map("cluster_id")
  creatorId      String              @map("creator_id")
  name           String
  status         SiteStatus          @default(ACTIVE)
  originPoolId   String              @map("origin_pool_id")
  policyId       String?             @map("policy_id")
  version        BigInt              @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  cluster        Cluster             @relation(fields: [clusterId], references: [id])
  creator        User                @relation(fields: [creatorId], references: [id])
  originPool     OriginPool          @relation(fields: [originPoolId], references: [id])
  policy         Policy?             @relation(fields: [policyId], references: [id])
  domains        SiteDomain[]
  certificates   SiteCertificate[]
  listenerConfig SiteListenerConfig?
  configVersions ConfigVersion[]
  publishJobs    PublishJob[]
  purgeJobs      PurgeJob[]

  @@unique([clusterId, name])
  @@index([clusterId, status])
  @@index([creatorId])
  @@index([originPoolId])
  @@index([policyId])
  @@map("sites")
}

model SiteCertificate {
  siteId        String      @map("site_id")
  certificateId String      @map("certificate_id")
  site          Site        @relation(fields: [siteId], references: [id])
  certificate   Certificate @relation(fields: [certificateId], references: [id])

  @@id([siteId, certificateId])
  @@index([certificateId])
  @@map("site_certificates")
}

model SiteDomain {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  hostname  String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  site      Site     @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@map("site_domains")
}

model SiteListenerConfig {
  id                    String        @id @default(uuid())
  siteId                String        @unique @map("site_id")
  httpEnabled           Boolean       @default(true) @map("http_enabled")
  httpPort              Int           @default(80) @map("http_port")
  redirectHttpToHttps   Boolean       @default(true) @map("redirect_http_to_https")
  httpsEnabled          Boolean       @default(true) @map("https_enabled")
  httpsPort             Int           @default(443) @map("https_port")
  http2Enabled          Boolean       @default(true) @map("http2_enabled")
  http3Enabled          Boolean       @default(true) @map("http3_enabled")
  tlsMinVersion         TLSMinVersion @default(TLS1_2) @map("tls_min_version")
  hstsEnabled           Boolean       @default(false) @map("hsts_enabled")
  hstsMaxAge            Int           @default(31536000) @map("hsts_max_age")
  hstsIncludeSubdomains Boolean       @default(false) @map("hsts_include_subdomains")
  hstsPreload           Boolean       @default(false) @map("hsts_preload")
  ocspStaplingEnabled   Boolean       @default(true) @map("ocsp_stapling_enabled")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  site                  Site          @relation(fields: [siteId], references: [id])

  @@map("site_listener_configs")
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String          @map("password_hash")
  name               String
  role               UserRole        @default(VIEWER)
  status             UserStatus      @default(ACTIVE)
  totpSecret         String?         @map("totp_secret")
  lastLoginAt        DateTime?       @map("last_login_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  sessions           UserSession[]
  auditLogs          AuditLog[]
  createdClusters    Cluster[]
  clusterMemberships ClusterMember[]
  createdSites       Site[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
