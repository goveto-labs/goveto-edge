datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "gco-go"
  output   = "./internal/storage/gen"
  package  = "db"
}

enum ACMEChallengeStatus {
  PENDING
  PRESENTED
  CLEANING
  CLEANED
  FAILED
}

enum ACMEChallengeType {
  HTTP_01
  DNS_01
}

enum CertificateOperation {
  ISSUE
  RENEW
  REISSUE
  REPUBLISH
}

enum CertificateSource {
  MANUAL
  ACME
}

enum CertificateStatus {
  PENDING
  ACTIVE
  DEPLOYING
  EXPIRING
  EXPIRED
  RENEWAL_FAILED
  DEPLOYMENT_FAILED
}

enum ClusterPermission {
  OWNER
  OPERATOR
  VIEWER
}

enum ConfigStatus {
  DRAFT
  PUBLISHED
  FAILED
  ROLLED_BACK
}

enum DNSProviderType {
  ALIYUN
  CLOUDFLARE
}

enum DNSRecordStatus {
  PENDING
  SYNCED
  FAILED
  DELETING
}

enum DNSRecordType {
  A
  AAAA
  CNAME
  TXT
}

enum DNSSyncAction {
  RECONCILE
  UPSERT_CLUSTER
  UPSERT_SITE
  DELETE_CLUSTER
  DELETE_SITE
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NodeStatus {
  PENDING
  INSTALLING
  ONLINE
  OFFLINE
  INSTALL_FAILED
  DISABLED
}

enum OriginProtocol {
  HTTP
  HTTPS
}

enum PurgeType {
  URL
  PREFIX
  TAG
  ALL
}

enum SSHAuthType {
  PASSWORD
  PRIVATE_KEY
}

enum SiteStatus {
  ACTIVE
  DISABLED
}

enum TLSMinVersion {
  TLS1_2
  TLS1_3
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model ACMEAccount {
  id                  String   @id @default(uuid())
  clusterId           String   @map("cluster_id")
  directoryUrl        String   @map("directory_url")
  email               String
  privateKeyEncrypted String   @db.Text @map("private_key_encrypted")
  accountJson         Json     @map("account_json")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  cluster             Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, directoryUrl, email])
  @@index([clusterId])
  @@map("acme_accounts")
}

model ACMEChallenge {
  id            String              @id @default(uuid())
  certificateId String              @map("certificate_id")
  clusterId     String              @map("cluster_id")
  type          ACMEChallengeType
  status        ACMEChallengeStatus @default(PENDING)
  domain        String
  token         String
  keyAuth       String?             @db.Text @map("key_auth")
  dnsName       String?             @map("dns_name")
  dnsValue      String?             @db.Text @map("dns_value")
  providerRef   String?             @map("provider_ref")
  lastError     String?             @db.Text @map("last_error")
  expiresAt     DateTime            @map("expires_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")
  certificate   Certificate         @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, type, domain, token])
  @@index([clusterId, status, expiresAt])
  @@index([token, status])
  @@map("acme_challenges")
}

model AgentTask {
  id          UUID      @id @default(uuid())
  nodeId      UUID      @map("node_id")
  kind        String
  payload     Json
  status      JobStatus @default(PENDING)
  leaseOwner  String?   @map("lease_owner")
  leaseUntil  DateTime? @map("lease_until")
  attempts    Int       @default(0)
  maxAttempts Int       @default(8) @map("max_attempts")
  resultJson  Json?     @map("result_json")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status, createdAt])
  @@index([status, leaseUntil])
  @@map("agent_tasks")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actor         String
  sourceIp      String   @default("unknown") @map("source_ip")
  userAgent     String   @default("") @db.Text @map("user_agent")
  action        String
  resourceType  String   @map("resource")
  resourceId    String   @default("unknown") @map("resource_id")
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  requestId     String   @default(uuid()) @map("request_id")
  result        String   @default("SUCCESS")
  failureReason String?  @db.Text @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([requestId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Certificate {
  id                   String             @id @default(uuid())
  clusterId            String             @map("cluster_id")
  name                 String
  source               CertificateSource  @default(MANUAL)
  status               CertificateStatus  @default(PENDING)
  certPem              String?            @db.Text @map("cert_pem")
  privateKeyPem        String?            @db.Text @map("private_key_pem")
  privateKeyEncrypted  String?            @db.Text @map("private_key_encrypted")
  fingerprint          String?
  serialNumber         String?            @map("serial_number")
  domainsJson          Json               @default("[]") @map("domains_json")
  notBefore            DateTime?          @map("not_before")
  expiresAt            DateTime?          @map("expires_at")
  issuer               String?
  keyAlgorithm         String?            @map("key_algorithm")
  acmeDirectoryUrl     String?            @map("acme_directory_url")
  acmeEmail            String?            @map("acme_email")
  acmeChallengeType    ACMEChallengeType? @map("acme_challenge_type")
  autoRenew            Boolean            @default(false) @map("auto_renew")
  renewBeforeDays      Int                @default(30) @map("renew_before_days")
  lastIssuedAt         DateTime?          @map("last_issued_at")
  lastRenewalAttemptAt DateTime?          @map("last_renewal_attempt_at")
  lastRenewalError     String?            @db.Text @map("last_renewal_error")
  lastPublishedAt      DateTime?          @map("last_published_at")
  lastPublishError     String?            @db.Text @map("last_publish_error")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at")
  cluster              Cluster            @relation(fields: [clusterId], references: [id])
  sites                SiteCertificate[]
  jobs                 CertificateJob[]
  challenges           ACMEChallenge[]

  @@unique([clusterId, name])
  @@index([clusterId, expiresAt])
  @@index([status, expiresAt])
  @@map("certificates")
}

model CertificateJob {
  id            String               @id @default(uuid())
  certificateId String               @map("certificate_id")
  operation     CertificateOperation
  status        JobStatus            @default(PENDING)
  attempts      Int                  @default(0)
  maxAttempts   Int                  @default(5) @map("max_attempts")
  nextAttemptAt DateTime             @default(now()) @map("next_attempt_at")
  leaseUntil    DateTime?            @map("lease_until")
  resultJson    Json?                @map("result_json")
  error         String?              @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at")
  certificate   Certificate          @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([certificateId, createdAt])
  @@map("certificate_jobs")
}

model Cluster {
  id              String             @id @default(uuid())
  creatorId       String             @map("creator_id")
  name            String
  primaryHostname String?            @unique @map("primary_hostname")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at")
  creator         User               @relation(fields: [creatorId], references: [id])
  members         ClusterMember[]
  nodes           Node[]
  groups          ClusterGroup[]
  regions         ClusterRegion[]
  dnsLines        DNSLine[]
  dnsProvider     DNSProviderConfig?
  dnsRecords      DNSManagedRecord[]
  dnsSyncJobs     DNSSyncJob[]
  certificates    Certificate[]
  acmeAccounts    ACMEAccount[]
  originPools     OriginPool[]
  sites           Site[]
  sshCredentials  SSHCredential[]

  @@unique([name])
  @@index([creatorId])
  @@map("clusters")
}

model ClusterGroup {
  id              String                @id @default(uuid())
  clusterId       String                @map("cluster_id")
  name            String
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at")
  cluster         Cluster               @relation(fields: [clusterId], references: [id])
  nodes           Node[]
  nodeMemberships NodeGroupMembership[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("node_groups")
}

model ClusterMember {
  clusterId  String            @map("cluster_id")
  userId     String            @map("user_id")
  permission ClusterPermission @default(OPERATOR)
  createdAt  DateTime          @default(now()) @map("created_at")
  cluster    Cluster           @relation(fields: [clusterId], references: [id])
  user       User              @relation(fields: [userId], references: [id])

  @@id([clusterId, userId])
  @@index([userId])
  @@map("cluster_members")
}

model ClusterRegion {
  id              String                 @id @default(uuid())
  clusterId       String                 @map("cluster_id")
  name            String
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at")
  cluster         Cluster                @relation(fields: [clusterId], references: [id])
  nodes           Node[]
  nodeMemberships NodeRegionMembership[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("node_regions")
}

model ConfigVersion {
  id         String       @id @default(uuid())
  siteId     String       @map("site_id")
  version    BigInt
  configJson Json         @map("config_json")
  hash       String
  status     ConfigStatus @default(DRAFT)
  createdAt  DateTime     @default(now()) @map("created_at")
  site       Site         @relation(fields: [siteId], references: [id])

  @@unique([siteId, version])
  @@index([siteId, status])
  @@index([createdAt])
  @@map("config_versions")
}

model DNSLine {
  id                 String             @id
  clusterId          String             @map("cluster_id")
  name               String
  providerCode       String             @default("default") @map("provider_code")
  providerParentCode String?            @map("provider_parent_code")
  sortOrder          Int                @default(0) @map("sort_order")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  cluster            Cluster            @relation(fields: [clusterId], references: [id])
  nodes              NodeDNSLine[]
  records            DNSManagedRecord[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("dns_lines")
}

model DNSManagedRecord {
  id               String          @id @default(uuid())
  clusterId        String          @map("cluster_id")
  siteDomainId     String?         @map("site_domain_id")
  dnsLineId        String?         @map("dns_line_id")
  dnsLineKey       String          @default("default") @map("dns_line_key")
  nodeId           UUID?           @map("node_id")
  hostname         String
  type             DNSRecordType
  value            String
  providerRecordId String?         @map("provider_record_id")
  status           DNSRecordStatus @default(PENDING)
  lastError        String?         @map("last_error") @db.Text
  lastSyncedAt     DateTime?       @map("last_synced_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  cluster          Cluster         @relation(fields: [clusterId], references: [id])
  siteDomain       SiteDomain?     @relation(fields: [siteDomainId], references: [id], onDelete: SetNull)
  dnsLine          DNSLine?        @relation(fields: [dnsLineId], references: [id])
  node             Node?           @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@unique([clusterId, hostname, type, value, dnsLineKey])
  @@index([clusterId, status])
  @@index([siteDomainId])
  @@index([dnsLineId])
  @@index([nodeId])
  @@map("dns_managed_records")
}

model DNSProviderConfig {
  id                   String          @id @default(uuid())
  clusterId            String          @unique @map("cluster_id")
  provider             DNSProviderType
  zone                 String
  zoneId               String?         @map("zone_id")
  credentialsEncrypted String          @map("credentials_encrypted") @db.Text
  defaultTtl           Int             @default(300) @map("default_ttl")
  proxied              Boolean         @default(false)
  enabled              Boolean         @default(true)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at")
  cluster              Cluster         @relation(fields: [clusterId], references: [id])

  @@index([provider, enabled])
  @@map("dns_provider_configs")
}

model DNSSyncJob {
  id            String        @id @default(uuid())
  clusterId     String        @map("cluster_id")
  siteId        String?       @map("site_id")
  action        DNSSyncAction
  status        JobStatus     @default(PENDING)
  attempts      Int           @default(0)
  maxAttempts   Int           @default(8) @map("max_attempts")
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at")
  leaseUntil    DateTime?     @map("lease_until")
  resultJson    Json?         @map("result_json")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  cluster       Cluster       @relation(fields: [clusterId], references: [id])
  site          Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([status, updatedAt])
  @@index([clusterId, createdAt])
  @@index([siteId, createdAt])
  @@map("dns_sync_jobs")
}

model DynamicSetting {
  key         String   @id
  valueJson   Json     @map("value_json")
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("dynamic_settings")
}

model Node {
  id                 UUID                    @id @default(uuid())
  clusterId          String                  @map("cluster_id")
  groupId            String?                 @map("group_id")
  regionId           String?                 @map("region_id")
  name               String
  version            String?
  heartbeatAt        DateTime?               @map("heartbeat_at")
  status             NodeStatus              @default(PENDING)
  installError       String?                 @map("install_error") @db.Text
  sshCredentialId    UUID?                   @map("ssh_credential_id")
  sshHost            String?                 @map("ssh_host")
  sshPort            Int?                    @map("ssh_port")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at")
  cluster            Cluster                 @relation(fields: [clusterId], references: [id])
  group              ClusterGroup?           @relation(fields: [groupId], references: [id])
  region             ClusterRegion?          @relation(fields: [regionId], references: [id])
  addresses          NodeAddress[]
  dnsLines           NodeDNSLine[]
  groupMemberships   NodeGroupMembership[]
  regionMemberships  NodeRegionMembership[]
  dnsRecords         DNSManagedRecord[]
  cacheConfig        NodeCacheConfig?
  hardwareProfile    NodeHardwareProfile?
  credential         NodeCredential?
  agentTasks         AgentTask[]
  sshCredential      SSHCredential?          @relation(fields: [sshCredentialId], references: [id])
  siteConfigVersions NodeSiteConfigVersion[]

  @@unique([clusterId, name])
  @@index([clusterId, status])
  @@index([groupId, status])
  @@index([regionId, status])
  @@index([heartbeatAt])
  @@index([sshCredentialId])
  @@map("nodes")
}

model NodeAddress {
  id        String   @id @default(uuid())
  nodeId    UUID     @map("node_id")
  address   String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  node      Node     @relation(fields: [nodeId], references: [id])

  @@index([nodeId])
  @@map("node_addresses")
}

model NodeCacheConfig {
  id                  String   @id @default(uuid())
  nodeId              UUID     @unique @map("node_id")
  cacheDir            String   @default("/opt/goveto-edge/cache") @map("cache_dir")
  autoMaxSize         Boolean  @default(true) @map("auto_max_size")
  maxSizeBytes        BigInt?  @map("max_size_bytes")
  maxDiskUsagePercent Int      @default(80) @map("max_disk_usage_percent")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  node                Node     @relation(fields: [nodeId], references: [id])

  @@map("node_cache_configs")
}

model NodeCredential {
  nodeId                        UUID      @id @map("node_id")
  certificateSerial             String?   @unique @map("certificate_serial")
  certificateNotAfter           DateTime? @map("certificate_not_after")
  bootstrapIdentityEncrypted    String?   @db.Text @map("bootstrap_identity_encrypted")
  previousCertificateSerial     String?   @map("previous_certificate_serial")
  previousCertificateValidUntil DateTime? @map("previous_certificate_valid_until")
  rotationCsrSha256             String?   @map("rotation_csr_sha256")
  rotationCertificatePem        String?   @db.Text @map("rotation_certificate_pem")
  revokedAt                     DateTime? @map("revoked_at")
  node                          Node      @relation(fields: [nodeId], references: [id])

  @@map("node_credentials")
}

model NodeDNSLine {
  nodeId    UUID    @map("node_id")
  dnsLineId String  @map("dns_line_id")
  node      Node    @relation(fields: [nodeId], references: [id])
  dnsLine   DNSLine @relation(fields: [dnsLineId], references: [id])

  @@id([nodeId, dnsLineId])
  @@index([dnsLineId])
  @@map("node_dns_lines")
}

model NodeGroupMembership {
  nodeId  UUID         @map("node_id")
  groupId String       @map("group_id")
  node    Node         @relation(fields: [nodeId], references: [id])
  group   ClusterGroup @relation(fields: [groupId], references: [id])

  @@id([nodeId, groupId])
  @@index([groupId])
  @@map("node_group_memberships")
}

model NodeHardwareProfile {
  nodeId                       UUID     @id @map("node_id")
  architecture                 String
  cpuModel                     String   @map("cpu_model")
  cacheDiskWriteBytesPerSecond BigInt?  @map("cache_disk_write_bytes_per_second")
  benchmarkBytes               BigInt?  @map("benchmark_bytes")
  benchmarkDurationMs          Int?     @map("benchmark_duration_ms")
  measuredAt                   DateTime @map("measured_at")
  node                         Node     @relation(fields: [nodeId], references: [id])

  @@map("node_hardware_profiles")
}

model NodeRegionMembership {
  nodeId   UUID          @map("node_id")
  regionId String        @map("region_id")
  node     Node          @relation(fields: [nodeId], references: [id])
  region   ClusterRegion @relation(fields: [regionId], references: [id])

  @@id([nodeId, regionId])
  @@index([regionId])
  @@map("node_region_memberships")
}

model NodeSiteConfigVersion {
  nodeId    UUID         @map("node_id")
  siteId    String       @map("site_id")
  version   BigInt
  status    ConfigStatus @default(PUBLISHED)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")
  node      Node         @relation(fields: [nodeId], references: [id])
  site      Site         @relation(fields: [siteId], references: [id])

  @@id([nodeId, siteId])
  @@index([siteId, status])
  @@map("node_site_config_versions")
}

model OriginBackend {
  id           String         @id @default(uuid())
  originPoolId String         @map("origin_pool_id")
  protocol     OriginProtocol @default(HTTPS)
  address      String
  hostHeader   String?        @map("host_header")
  weight       Int            @default(1)
  priority     Int            @default(0)
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  originPool   OriginPool     @relation(fields: [originPoolId], references: [id])

  @@index([originPoolId, enabled])
  @@map("origin_backends")
}

model OriginPool {
  id         String          @id @default(uuid())
  clusterId  String          @map("cluster_id")
  name       String
  scheduler  String          @default("round_robin")
  healthUri  String          @default("/health") @map("health_uri")
  timeout    Int             @default(10000)
  headers    Json
  governance Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at")
  cluster    Cluster         @relation(fields: [clusterId], references: [id])
  backends   OriginBackend[]
  sites      Site[]

  @@index([clusterId])
  @@map("origin_pools")
}

model Policy {
  id              String   @id @default(uuid())
  name            String
  cacheJson       Json     @map("cache_json")
  compressionJson Json     @default("{}") @map("compression_json")
  wafJson         Json     @map("waf_json")
  ccJson          Json     @map("cc_json")
  accessJson      Json     @map("access_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  sites           Site[]

  @@map("policies")
}

model PublishJob {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  version    BigInt
  targets    Json
  status     JobStatus @default(PENDING)
  resultJson Json?     @map("result_json")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  site       Site      @relation(fields: [siteId], references: [id])

  @@index([siteId, version])
  @@index([status, createdAt])
  @@map("publish_jobs")
}

model PurgeJob {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  type       PurgeType
  value      String?
  status     JobStatus @default(PENDING)
  resultJson Json?     @map("result_json")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  site       Site      @relation(fields: [siteId], references: [id])

  @@index([siteId, status])
  @@index([status, createdAt])
  @@map("purge_jobs")
}

model SSHCredential {
  id              UUID        @id @default(uuid())
  clusterId       String      @map("cluster_id")
  name            String
  username        String
  authType        SSHAuthType @map("auth_type")
  secretEncrypted String      @map("secret_encrypted") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  cluster         Cluster     @relation(fields: [clusterId], references: [id])
  nodes           Node[]

  @@unique([clusterId, name])
  @@index([clusterId])
  @@map("ssh_credentials")
}

model Site {
  id                 String                  @id @default(uuid())
  clusterId          String                  @map("cluster_id")
  creatorId          String                  @map("creator_id")
  name               String
  status             SiteStatus              @default(ACTIVE)
  originPoolId       String                  @map("origin_pool_id")
  policyId           String?                 @map("policy_id")
  version            BigInt                  @default(1)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at")
  cluster            Cluster                 @relation(fields: [clusterId], references: [id])
  creator            User                    @relation(fields: [creatorId], references: [id])
  originPool         OriginPool              @relation(fields: [originPoolId], references: [id])
  policy             Policy?                 @relation(fields: [policyId], references: [id])
  domains            SiteDomain[]
  certificates       SiteCertificate[]
  listenerConfig     SiteListenerConfig?
  nodeConfigVersions NodeSiteConfigVersion[]
  configVersions     ConfigVersion[]
  publishJobs        PublishJob[]
  purgeJobs          PurgeJob[]
  dnsSyncJobs        DNSSyncJob[]

  @@unique([clusterId, name])
  @@index([clusterId, status])
  @@index([creatorId])
  @@index([originPoolId])
  @@index([policyId])
  @@map("sites")
}

model SiteCertificate {
  siteId        String      @map("site_id")
  certificateId String      @map("certificate_id")
  site          Site        @relation(fields: [siteId], references: [id])
  certificate   Certificate @relation(fields: [certificateId], references: [id])

  @@id([siteId, certificateId])
  @@index([certificateId])
  @@map("site_certificates")
}

model SiteDomain {
  id         String             @id @default(uuid())
  siteId     String             @map("site_id")
  hostname   String             @unique
  createdAt  DateTime           @default(now()) @map("created_at")
  site       Site               @relation(fields: [siteId], references: [id])
  dnsRecords DNSManagedRecord[]

  @@index([siteId])
  @@map("site_domains")
}

model SiteListenerConfig {
  id                    String        @id @default(uuid())
  siteId                String        @unique @map("site_id")
  httpEnabled           Boolean       @default(true) @map("http_enabled")
  httpPort              Int           @default(80) @map("http_port")
  redirectHttpToHttps   Boolean       @default(true) @map("redirect_http_to_https")
  httpsEnabled          Boolean       @default(true) @map("https_enabled")
  httpsPort             Int           @default(443) @map("https_port")
  http2Enabled          Boolean       @default(true) @map("http2_enabled")
  http3Enabled          Boolean       @default(true) @map("http3_enabled")
  tlsMinVersion         TLSMinVersion @default(TLS1_2) @map("tls_min_version")
  hstsEnabled           Boolean       @default(false) @map("hsts_enabled")
  hstsMaxAge            Int           @default(31536000) @map("hsts_max_age")
  hstsIncludeSubdomains Boolean       @default(false) @map("hsts_include_subdomains")
  hstsPreload           Boolean       @default(false) @map("hsts_preload")
  ocspStaplingEnabled   Boolean       @default(true) @map("ocsp_stapling_enabled")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at")
  site                  Site          @relation(fields: [siteId], references: [id])

  @@map("site_listener_configs")
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String          @map("password_hash")
  name               String
  role               UserRole        @default(VIEWER)
  status             UserStatus      @default(ACTIVE)
  totpSecret         String?         @map("totp_secret")
  lastLoginAt        DateTime?       @map("last_login_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")
  sessions           UserSession[]
  auditLogs          AuditLog[]
  createdClusters    Cluster[]
  clusterMemberships ClusterMember[]
  createdSites       Site[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}
