{
  "name": "goveto-edge-console",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-waf-worker.mjs && tsc && vite build",
    "build:waf-worker": "node scripts/build-waf-worker.mjs",
    "lint": "biome check .",
    "format": "biome format . --write",
    "fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
