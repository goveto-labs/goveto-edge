    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@lezer/highlight": "^1.2.3",
    "axios": "^1.18.1",
    "clsx": "2.1.1",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.23.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
